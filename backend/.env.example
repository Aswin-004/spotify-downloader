# ── Spotify ────────────────────────────────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# LOCAL DEV: http://127.0.0.1:8888/callback
# PRODUCTION: https://your-app.onrender.com/callback  (must match Spotify Dashboard)
REDIRECT_URI=http://127.0.0.1:8888/callback

# ── Playlists ──────────────────────────────────────────────────────────────
# Playlist used as an ingest queue — new tracks here are auto-downloaded
INGEST_PLAYLIST_ID=your_ingest_playlist_id

# ── Music Library ──────────────────────────────────────────────────────────
# Absolute path to your music folder (where tracks are downloaded and organised)
# LOCAL: C:\path\to\your\DJ music
# PRODUCTION: leave blank or set to /data/music if using a mounted disk
BASE_DOWNLOAD_DIR=C:\path\to\your\DJ music

# ── Flask ──────────────────────────────────────────────────────────────────
FLASK_ENV=production
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_random_64_char_hex_string

# ── CORS ───────────────────────────────────────────────────────────────────
# LOCAL DEV: leave blank (defaults to localhost origins)
# PRODUCTION: comma-separated list of allowed frontend origins
# Example: https://your-app.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=

# ── Auto-sync interval (milliseconds between playlist checks) ──────────────
CHECK_INTERVAL=500

# ── Redis + Celery ─────────────────────────────────────────────────────────
# LOCAL DEV: redis://localhost:6379/0
# PRODUCTION: your Upstash or Render Redis TLS URL
# App falls back to threading if Redis is unavailable (dev only)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── MongoDB ────────────────────────────────────────────────────────────────
# LOCAL DEV: mongodb://localhost:27017
# PRODUCTION: your MongoDB Atlas connection string (required)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=spotify_downloader

# ── SocketIO ───────────────────────────────────────────────────────────────
# LOCAL DEV: threading (default)
# PRODUCTION: gevent  (requires gunicorn + gevent worker)
SOCKETIO_ASYNC_MODE=threading
# Allow WebSocket upgrades — safe only under Gunicorn+gevent, NOT Werkzeug dev server.
# LOCAL DEV: false (default)   PRODUCTION: true
SOCKETIO_ALLOW_UPGRADES=false

# ── Telegram notifications (optional) ─────────────────────────────────────
# Leave blank to disable notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI / fingerprinting APIs ──────────────────────────────────────────────
# Groq — https://console.groq.com/keys  (free tier: 14400 calls/day)
GROQ_API_KEY=your_groq_api_key
# Chat model used for genre classification — see https://console.groq.com/docs/models,
# or run this project's own live check: from the backend/ dir,
#   python -c "from config import config; from groq import Groq; c = Groq(api_key=config.GROQ_API_KEY); print('\n'.join(sorted(m.id for m in c.models.list().data)))"
# to see exactly which models your account/key can use — entitlements vary per
# account and Llama models in particular may not be enabled on yours.
# Defaults to openai/gpt-oss-20b (general-purpose, not an agentic/tool-using model).
GROQ_MODEL=openai/gpt-oss-20b
# Google Gemini — https://aistudio.google.com/app/apikey (legacy, optional)
GEMINI_API_KEY=
# Last.fm — https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key
# AcoustID — https://acoustid.org/api-key
ACOUSTID_API_KEY=your_acoustid_api_key
# Path to fpcalc executable (AcoustID fingerprinter, download from acoustid.org/chromaprint)
# LOCAL: C:\path\to\fpcalc.exe   LINUX/RENDER: /usr/bin/fpcalc
FPCALC_PATH=C:\path\to\fpcalc.exe

# ── Storage alert threshold (MB) ──────────────────────────────────────────
NOTIFY_STORAGE_THRESHOLD_MB=100000

# ── Production feature flags ───────────────────────────────────────────────
# Set to 1 in production to disable CPU-heavy features that OOM on small dynos
DISABLE_BPM_ANALYSIS=0
DISABLE_FINGERPRINTING=0
