# ═══════════════════════════════════════════════════════════════════════════
#  Spotify Meta Downloader — settings (copy of this file = backend/.env)
#  setup.bat creates backend/.env from this file. Fill in the REQUIRED part,
#  save, then run start.bat. Step-by-step guide with screenshots-free
#  instructions: docs/SETUP.md
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────── REQUIRED ─────────────────────────────────────

# Spotify app — https://developer.spotify.com/dashboard → Create app.
# In the app's settings add this Redirect URI exactly: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
REDIRECT_URI=http://127.0.0.1:8888/callback

# The playlist the app watches: add a song to it in Spotify and it is downloaded + sorted.
# Must be a playlist YOU own. Paste its link or just the id (the part after /playlist/).
INGEST_PLAYLIST_ID=your_ingest_playlist_id

# Where your music goes. Songs land in <this folder>\Library\<Genre>\ (created automatically).
BASE_DOWNLOAD_DIR=C:\Users\YourName\Music\DJ music

# Database (free) — https://www.mongodb.com/cloud/atlas/register → create a free M0 cluster →
# Connect → Drivers → copy the connection string and put your database user's password in it.
# (Or install MongoDB locally and use mongodb://localhost:27017)
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=spotify_downloader

# Groq (free) — https://console.groq.com/keys. Listens to songs nothing else recognises and picks their genre.
GROQ_API_KEY=your_groq_api_key

# ───────────────────────── RECOMMENDED (free) ────────────────────────────────

# Last.fm — https://www.last.fm/api/account/create (genre evidence for unknown artists)
LASTFM_API_KEY=your_lastfm_api_key
# AcoustID — https://acoustid.org/new-application (checks each download is the right song, not a cover/karaoke)
ACOUSTID_API_KEY=your_acoustid_api_key
# fpcalc is AcoustID's fingerprint tool: https://acoustid.org/chromaprint → download → put fpcalc.exe in backend\
# (or give its full path here). Without it the audio check is simply skipped.
FPCALC_PATH=

# ───────────────────────── Leave as they are ────────────────────────────────

FLASK_ENV=development
# Any long random text. setup.bat fills in a random one for you.
SECRET_KEY=change_me_to_a_random_64_char_hex_string

# Seconds between playlist checks. Values below 600 are raised to 600 (Spotify locks an app out for ~22 h
# when it is asked too often). "Sync now" in the app checks immediately.
CHECK_INTERVAL=600

# How unknown songs are sorted: verified Last.fm/MusicBrainz/iTunes evidence first, then Groq listens.
INGEST_EVIDENCE_ROUTING=true
# Groq must be at least this sure (0-1) before it files a song; below that the song waits in Library\Electronic.
AI_MIN_CONFIDENCE=0.4
# The hourly job lets Groq listen to songs left in the Electronic catch-all (each song once a week at most).
AI_CATCHALL_MOVES=true
# Learn from songs you move between genre folders yourself: the artist's next song goes to the same folder.
HAND_MOVE_LEARNING=true
# Groq models (see https://console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3

# After each download, fingerprint it and reject a different song / karaoke / cover: enforce | flag | off
AUDIO_VERIFY_MODE=enforce
# GENRE_EVIDENCE_MIN_CONFIDENCE=0.60

# Optional Discord alerts: Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=
NOTIFY_STORAGE_THRESHOLD_MB=100000

# Optional Redis (faster task queue). Without Redis the app uses threads — fine for one person.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

SOCKETIO_ASYNC_MODE=threading
SOCKETIO_ALLOW_UPGRADES=false

# ─────────────── Only for a cloud deploy (Render/Vercel) — ignore locally ─────────────
# FLASK_ENV=production  (then SECRET_KEY, REDIS_URL, a MongoDB Atlas URI, a public REDIRECT_URI and
# ALLOWED_ORIGINS become required)
# ALLOWED_ORIGINS=https://your-app.vercel.app
# DISABLE_BPM_ANALYSIS=1
# DISABLE_FINGERPRINTING=1
