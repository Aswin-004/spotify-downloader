# ── Backend connection ──────────────────────────────────────────────────────
# LOCAL DEV: leave blank — Vite proxy handles /api → localhost:5000
# PRODUCTION: your Render backend URL (no trailing slash)
VITE_API_BASE_URL=

# ── SocketIO connection ─────────────────────────────────────────────────────
# LOCAL DEV: leave blank — Vite proxy handles /socket.io
# PRODUCTION: same as VITE_API_BASE_URL (same backend serves WebSocket)
VITE_SOCKET_URL=

# ── SocketIO transports ─────────────────────────────────────────────────────
# LOCAL DEV: polling (Werkzeug threading mode, no WS upgrades)
# PRODUCTION: polling,websocket (gevent worker supports both)
VITE_SOCKET_TRANSPORTS=polling

# ── Vite dev proxy target ───────────────────────────────────────────────────
# Only used in local dev. Change if your backend runs on a different port.
VITE_BACKEND_PROXY_TARGET=http://localhost:5000
